<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The COSMIC design tokens, as in the QGIS plugin's styles.py. Use these; do not pick new values. -->

    <Color x:Key="Cosmic.Color.Background">#0B131A</Color>
    <Color x:Key="Cosmic.Color.BackgroundRaised">#0E161D</Color>
    <Color x:Key="Cosmic.Color.Surface">#121A21</Color>
    <Color x:Key="Cosmic.Color.SurfaceRaised">#1A242C</Color>
    <Color x:Key="Cosmic.Color.Border">#22303A</Color>
    <Color x:Key="Cosmic.Color.Text">#E3EBF1</Color>
    <Color x:Key="Cosmic.Color.TextMuted">#8695A2</Color>
    <Color x:Key="Cosmic.Color.TextDim">#67757F</Color>
    <Color x:Key="Cosmic.Color.Accent">#009FE8</Color>
    <Color x:Key="Cosmic.Color.AccentHover">#2BB4F0</Color>
    <Color x:Key="Cosmic.Color.AccentPressed">#0079B3</Color>
    <Color x:Key="Cosmic.Color.AccentBright">#5BC2F2</Color>
    <Color x:Key="Cosmic.Color.Success">#6CC39A</Color>
    <Color x:Key="Cosmic.Color.Warning">#E3AB63</Color>
    <Color x:Key="Cosmic.Color.Error">#E08B80</Color>

    <SolidColorBrush x:Key="Cosmic.Background" Color="{StaticResource Cosmic.Color.Background}" />
    <SolidColorBrush x:Key="Cosmic.BackgroundRaised" Color="{StaticResource Cosmic.Color.BackgroundRaised}" />
    <SolidColorBrush x:Key="Cosmic.Surface" Color="{StaticResource Cosmic.Color.Surface}" />
    <SolidColorBrush x:Key="Cosmic.SurfaceRaised" Color="{StaticResource Cosmic.Color.SurfaceRaised}" />
    <SolidColorBrush x:Key="Cosmic.Border" Color="{StaticResource Cosmic.Color.Border}" />
    <SolidColorBrush x:Key="Cosmic.Text" Color="{StaticResource Cosmic.Color.Text}" />
    <SolidColorBrush x:Key="Cosmic.TextMuted" Color="{StaticResource Cosmic.Color.TextMuted}" />
    <SolidColorBrush x:Key="Cosmic.TextDim" Color="{StaticResource Cosmic.Color.TextDim}" />
    <SolidColorBrush x:Key="Cosmic.Accent" Color="{StaticResource Cosmic.Color.Accent}" />
    <SolidColorBrush x:Key="Cosmic.AccentHover" Color="{StaticResource Cosmic.Color.AccentHover}" />
    <SolidColorBrush x:Key="Cosmic.AccentPressed" Color="{StaticResource Cosmic.Color.AccentPressed}" />
    <SolidColorBrush x:Key="Cosmic.AccentBright" Color="{StaticResource Cosmic.Color.AccentBright}" />
    <SolidColorBrush x:Key="Cosmic.Success" Color="{StaticResource Cosmic.Color.Success}" />
    <SolidColorBrush x:Key="Cosmic.Warning" Color="{StaticResource Cosmic.Color.Warning}" />
    <SolidColorBrush x:Key="Cosmic.Error" Color="{StaticResource Cosmic.Color.Error}" />

    <FontFamily x:Key="Cosmic.FontFamily">IBM Plex Sans, Segoe UI, Noto Sans JP, Arial</FontFamily>
    <FontFamily x:Key="Cosmic.FontFamilyMono">IBM Plex Mono, Consolas, Courier New</FontFamily>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Cosmic.FontSize">13</sys:Double>

    <!-- Tabs: text with an accent underline, no chrome. -->
    <Style x:Key="Cosmic.TabControl" TargetType="TabControl">
        <Setter Property="Background" Value="{StaticResource Cosmic.Background}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource Cosmic.FontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource Cosmic.FontSize}" />
    </Style>

    <Style x:Key="Cosmic.TabItem" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource Cosmic.TextDim}" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Underline" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Cosmic.AccentBright}" />
                            <Setter TargetName="Underline" Property="BorderBrush" Value="{StaticResource Cosmic.Accent}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Cosmic.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
