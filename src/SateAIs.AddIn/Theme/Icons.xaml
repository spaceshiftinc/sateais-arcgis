<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Icon outlines in a 24-unit box, the same path data every SateAIs client uses.
         Drawn with a 1.6 stroke, round caps and joins, in the detection type's colour. -->

    <GeometryGroup x:Key="Icon.ship">
        <PathGeometry Figures="M4 17h16l-2 4H6l-2-4Z" />
        <PathGeometry Figures="M6 17V9h12v8" />
        <PathGeometry Figures="M12 9V4" />
    </GeometryGroup>
    <GeometryGroup x:Key="Icon.oilslick">
        <PathGeometry Figures="M12 3c0 0 4.2 5.4 4.2 8.2a4.2 4.2 0 0 1-8.4 0C7.8 8.4 12 3 12 3Z" />
        <PathGeometry Figures="M3 19c3-2.6 6 2.6 9 0s6 2.6 9 0" />
    </GeometryGroup>
    <GeometryGroup x:Key="Icon.newbuilding">
        <PathGeometry Figures="M4 21V10l6-4v15" />
        <PathGeometry Figures="M14 21V13l6-3v11" />
        <PathGeometry Figures="M12 3v4" />
        <PathGeometry Figures="M10 5h4" />
    </GeometryGroup>
    <!-- The missing building is dashed; drawn as a second path in the view. -->
    <GeometryGroup x:Key="Icon.disappearbuilding">
        <PathGeometry Figures="M4 21V10l6-4v15" />
    </GeometryGroup>
    <GeometryGroup x:Key="Icon.disappearbuilding.dashed">
        <PathGeometry Figures="M14 21v-3" />
        <PathGeometry Figures="M14 14v-1" />
        <PathGeometry Figures="M20 21V10" />
    </GeometryGroup>
    <GeometryGroup x:Key="Icon.timeseries">
        <PathGeometry Figures="M3 18l5-6 4 3 5-8 4 5" />
        <PathGeometry Figures="M3 21h18" />
    </GeometryGroup>

    <GeometryGroup x:Key="Icon.target">
        <EllipseGeometry Center="12,12" RadiusX="8" RadiusY="8" />
        <EllipseGeometry Center="12,12" RadiusX="3.2" RadiusY="3.2" />
        <PathGeometry Figures="M12 2v2M12 20v2M2 12h2M20 12h2" />
    </GeometryGroup>
    <GeometryGroup x:Key="Icon.calendar">
        <RectangleGeometry Rect="3.5,5,17,15" RadiusX="2.5" RadiusY="2.5" />
        <PathGeometry Figures="M3.5 10h17" />
        <PathGeometry Figures="M8 3v4M16 3v4" />
    </GeometryGroup>
    <!-- The spark from the SPACESHIFT wordmark, filled rather than stroked. Marks a find. -->
    <GeometryGroup x:Key="Icon.spark" FillRule="Nonzero">
        <GeometryGroup.Transform>
            <TranslateTransform X="-160" Y="-52" />
        </GeometryGroup.Transform>
        <PathGeometry Figures="M173.9,55.9 L169.4,55.9 L171.6,52 Z M173.9,71.6 L169.4,71.6 L171.6,75.5 Z M171,55.6 L166.9,57.1 L167.6,52.7 Z M176.4,70.4 L172.2,71.9 L175.7,74.8 Z M168.3,56.3 L164.9,59.1 L164.1,54.7 Z M178.4,68.3 L175,71.2 L179.2,72.7 Z M165.9,57.9 L163.7,61.7 L161.5,57.9 Z M179.6,65.7 L177.3,69.6 L181.8,69.6 Z M164.3,60.2 L163.5,64.6 L160.1,61.7 Z M179.8,62.9 L179,67.3 L183.2,65.8 Z M163.5,62.9 L164.3,67.3 L160.1,65.8 Z M179,60.2 L179.8,64.6 L183.2,61.7 Z M163.7,65.7 L165.9,69.6 L161.5,69.6 Z M177.3,57.9 L179.6,61.7 L181.8,57.9 Z M164.9,68.3 L168.3,71.2 L164.1,72.7 Z M175,56.3 L178.4,59.1 L179.2,54.7 Z M166.9,70.4 L171,71.9 L167.6,74.8 Z M172.2,55.6 L176.4,57.1 L175.7,52.7 Z" />
        <EllipseGeometry Center="171.6,63.6" RadiusX="8.4" RadiusY="8.4" />
