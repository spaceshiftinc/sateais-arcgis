    <GeometryGroup x:Key="Icon.draw">
        <PathGeometry Figures="M4 8V5.5A1.5 1.5 0 0 1 5.5 4H8" />
        <PathGeometry Figures="M16 4h2.5A1.5 1.5 0 0 1 20 5.5V8" />
        <PathGeometry Figures="M20 16v2.5a1.5 1.5 0 0 1-1.5 1.5H16" />
        <PathGeometry Figures="M8 20H5.5A1.5 1.5 0 0 1 4 18.5V16" />
        <PathGeometry Figures="M4 12h1.5M10.5 12h3M18.5 12H20M12 4v1.5M12 10.5v3M12 18.5V20" />
