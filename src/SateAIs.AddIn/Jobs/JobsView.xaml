<UserControl x:Class="SateAIs.AddIn.Jobs.JobsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SateAIs.AddIn"
             xmlns:jobs="clr-namespace:SateAIs.AddIn.Jobs">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SateAIs.AddIn;component/Theme/Cosmic.xaml" />
                <ResourceDictionary Source="pack://application:,,,/SateAIs.AddIn;component/Theme/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
            <local:BoolToHiddenConverter x:Key="BoolToHidden" />
            <local:HexToBrushConverter x:Key="HexToBrush" />
            <local:IconKeyConverter x:Key="IconKey" />
            <local:StatusKindToBrushConverter x:Key="StatusBrush" />

            <Style x:Key="IconPath" TargetType="Path">
                <Setter Property="StrokeThickness" Value="1.6" />
                <Setter Property="StrokeLineJoin" Value="Round" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
                <Setter Property="Fill" Value="Transparent" />
            </Style>

            <!-- One job. The row itself is the control: a completed job opens its result, any other shows its area. -->
            <DataTemplate x:Key="JobCard" DataType="{x:Type jobs:JobCardViewModel}">
                <Button Style="{StaticResource Cosmic.JobCard}" ToolTip="{Binding Tooltip}"
                        Command="{Binding DataContext.CardClickedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                        Visibility="{Binding Shown, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- what, and how many -->
                        <Viewbox Grid.Row="0" Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource IconPath}" Data="{Binding TypeIcon, Converter={StaticResource IconKey}}" Stroke="{Binding TypeColor, Converter={StaticResource HexToBrush}}" />
                                <Path Style="{StaticResource IconPath}" Data="{Binding TypeIcon, Converter={StaticResource IconKey}, ConverterParameter=.dashed}" Stroke="{Binding TypeColor, Converter={StaticResource HexToBrush}}" StrokeDashArray="3 3" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TypeLabel}" Style="{StaticResource Cosmic.JobTitle}" Margin="8,0,0,0" />
                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding FindVisible, Converter={StaticResource BoolToVis}}" ToolTip="{Binding FindTooltip}">
                            <Viewbox Width="11" Height="11" Margin="0,0,5,0" Visibility="{Binding FindSparkVisible, Converter={StaticResource BoolToHidden}}">
                                <Path Data="{StaticResource Icon.spark}" Fill="{StaticResource Cosmic.Accent}" />
                            </Viewbox>
                            <TextBlock Text="{Binding FindText}" Style="{StaticResource Cosmic.Hint}" Foreground="{Binding FindKind, Converter={StaticResource StatusBrush}}" />
                        </StackPanel>

                        <!-- when, and in what state -->
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SubmittedText}" Style="{StaticResource Cosmic.Subtitle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="8,5,0,0" VerticalAlignment="Center" />
                        <Border Grid.Row="1" Grid.Column="2" Margin="8,5,0,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Cosmic.Pill}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="ok">
                                            <Setter Property="Background" Value="{StaticResource Cosmic.PillOkBackground}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="error">
                                            <Setter Property="Background" Value="{StaticResource Cosmic.PillErrorBackground}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StatusLabel}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Cosmic.PillText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="ok">
                                                <Setter Property="Foreground" Value="{StaticResource Cosmic.Success}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="error">
                                                <Setter Property="Foreground" Value="{StaticResource Cosmic.Error}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <!-- what was asked for -->
                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding RequestText}" Style="{StaticResource Cosmic.JobMeta}" Margin="8,5,0,0"
                                   Visibility="{Binding RequestVisible, Converter={StaticResource BoolToVis}}" />

                        <!-- the figures, each with its caption -->
                        <ItemsControl Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding MetaFields}" Margin="8,5,0,0"
                                      Visibility="{Binding MetaVisible, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type jobs:MetaField}">
                                    <TextBlock Style="{StaticResource Cosmic.JobMeta}" Margin="0,0,10,0">
                                        <Run Text="{Binding Label, Mode=OneWay}" Foreground="{StaticResource Cosmic.MetaLabel}" /><Run Text="&#160;" /><Run Text="{Binding Value, Mode=OneWay}" Foreground="{StaticResource Cosmic.MetaValue}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- the id, for copying; never the first thing read -->
                        <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding JobId, Mode=OneWay}" Style="{StaticResource Cosmic.JobId}" Margin="8,5,0,0" />

                        <TextBlock Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding ErrorText}" Style="{StaticResource Cosmic.Hint}" FontSize="12.5"
                                   Foreground="{StaticResource Cosmic.Warning}" Margin="8,5,0,0" Visibility="{Binding ErrorVisible, Converter={StaticResource BoolToVis}}" />

                        <StackPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="8,7,0,0"
                                    Visibility="{Binding Loading, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="✦" Foreground="{StaticResource Cosmic.Accent}" FontSize="14" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform x:Name="FetchSpin" />
                                </TextBlock.RenderTransform>
                                <TextBlock.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="FetchSpin" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:3" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </TextBlock.Triggers>
                            </TextBlock>
                            <TextBlock Text="Fetching result…" Style="{StaticResource Cosmic.Hint}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Button>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Background="{StaticResource Cosmic.Background}">

        <!-- Header: one button. Pulling from the server and re-polling are the same "make it current" to the user. -->
        <Grid DockPanel.Dock="Top" Margin="12,12,12,0">
            <TextBlock Text="Jobs" Style="{StaticResource Cosmic.Title}" VerticalAlignment="Center" />
            <Button Content="Refresh" Style="{StaticResource Cosmic.Chip}" HorizontalAlignment="Right" Command="{Binding RefreshCommand}" />
        </Grid>

        <!-- Search: narrows as you type, over id, type, scene and dates -->
        <Grid DockPanel.Dock="Top" Margin="12,10,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="SearchBox" Style="{StaticResource Cosmic.TextBox}" Padding="12,7,30,7" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Search jobs — ID, type, scene, date" FontFamily="{StaticResource Cosmic.FontFamily}" FontSize="13" Foreground="{StaticResource Cosmic.TextDim}"
                           Margin="13,8,0,0" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Content="✕" Style="{StaticResource Cosmic.GhostButton}" FontSize="11" Padding="8,0" HorizontalAlignment="Right" Command="{Binding ClearSearchCommand}"
                        Visibility="{Binding SearchActive, Converter={StaticResource BoolToVis}}" />
            </Grid>
            <TextBlock Grid.Column="1" Text="{Binding MatchCountText}" Style="{StaticResource Cosmic.Hint}" Margin="8,0,0,0" VerticalAlignment="Center"
                       Visibility="{Binding MatchCountVisible, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- "none yet" and "none match" are different states; one sentence for both reads as jobs lost -->
        <TextBlock DockPanel.Dock="Top" Text="No jobs match this search." Style="{StaticResource Cosmic.Hint}" Margin="12,10,12,0"
                   Visibility="{Binding NoMatchVisible, Converter={StaticResource BoolToVis}}" />

        <Grid Margin="0,10,0,0">
            <!-- Empty state -->
            <Grid Visibility="{Binding EmptyVisible, Converter={StaticResource BoolToVis}}">
                <jobs:Starfield />
                <StackPanel VerticalAlignment="Center" Margin="24,36">
                    <TextBlock Text="Ready when you are" Style="{StaticResource Cosmic.EmptyTitle}" />
                    <TextBlock Text="Pick an area on the map and run a detection.&#x0a;Your jobs and results appear here." Style="{StaticResource Cosmic.EmptySubtitle}" Margin="0,10,0,0" />
                    <Button Content="Start an analysis" Style="{StaticResource Cosmic.PrimaryButton}" HorizontalAlignment="Center" Margin="0,16,0,0" Command="{Binding StartAnalysisCommand}" />
                </StackPanel>
            </Grid>

            <!-- The list: rows separated by a rule, no gaps -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding EmptyVisible, Converter={StaticResource InverseBoolToVis}}">
                <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource JobCard}" Margin="12,0" />
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
