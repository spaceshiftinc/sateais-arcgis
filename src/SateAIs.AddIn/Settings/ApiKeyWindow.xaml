<controls:ProWindow x:Class="SateAIs.AddIn.Settings.ApiKeyWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
                    xmlns:local="clr-namespace:SateAIs.AddIn"
                    Title="SateAIs Settings" Width="460" SizeToContent="Height" ResizeMode="NoResize"
                    WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <controls:ProWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SateAIs.AddIn;component/Theme/Cosmic.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
            <local:StatusKindToBrushConverter x:Key="StatusBrush" />
        </ResourceDictionary>
    </controls:ProWindow.Resources>
    <Border Background="{StaticResource Cosmic.Background}" Padding="24,24,24,20">
        <StackPanel>
            <TextBlock Text="SPACESHIFT" FontWeight="Bold" FontSize="15" Foreground="{StaticResource Cosmic.Text}" />
            <TextBlock Text="SateAIs Settings" Style="{StaticResource Cosmic.Title}" Margin="0,8,0,0" />
            <TextBlock Text="Configure your API key to connect to the SateAIs API." Style="{StaticResource Cosmic.Subtitle}" Margin="0,4,0,14" />

            <TextBlock Text="API Key" Style="{StaticResource Cosmic.Section}" Margin="0,0,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="Secret" Style="{StaticResource Cosmic.PasswordBox}"
                             Visibility="{Binding IsChecked, ElementName=ShowKey, Converter={StaticResource InverseBoolToVis}}" />
                <TextBox x:Name="Plain" Style="{StaticResource Cosmic.TextBox}" Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsChecked, ElementName=ShowKey, Converter={StaticResource BoolToVis}}" />
                <CheckBox x:Name="ShowKey" Grid.Column="1" Content="Show" Margin="8,0,0,0" Style="{StaticResource Cosmic.CheckBox}" />
            </Grid>
            <Button Content="Get an API key at console.spcsft.com →" Style="{StaticResource Cosmic.GhostButton}"
                    Command="{Binding OpenRegisterCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />

            <Border Height="1" Background="{StaticResource Cosmic.Border}" Margin="0,14" />

            <Button Content="Test Connection" Style="{StaticResource Cosmic.Button}" Command="{Binding TestCommand}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Cosmic.Hint}" FontSize="12.5" TextAlignment="Center" Margin="0,10,0,0"
                       Foreground="{Binding StatusKind, Converter={StaticResource StatusBrush}}" />
            <ProgressBar IsIndeterminate="True" Style="{StaticResource Cosmic.Meter}" Margin="0,8,0,0"
                         Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" Style="{StaticResource Cosmic.Button}" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                <Button Content="Save and Close" Style="{StaticResource Cosmic.PrimaryButton}" Command="{Binding SaveCommand}" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</controls:ProWindow>
